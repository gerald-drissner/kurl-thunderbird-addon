{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "short_name": "kURL",
  "version": "2.0.11",
  "author": "Gerald Drißner",
  "default_locale": "en",
  "description": "__MSG_extensionDescription__",
  "browser_specific_settings": {
    "gecko": {
      "id": "yourls@drissner.me",
      "strict_min_version": "140.0"
    }
  },
  "icons": {
    "48": "images/kurl-icon-48.png",
    "96": "images/kurl-icon-96.png",
    "16": "images/kurl-icon-16.png",
    "32": "images/kurl-icon-32.png"
  },
  "background": {
    "scripts": [
      "JS/helpers.js",
      "JS/background.js"
    ]
  },
  "commands": {
    "_execute_compose_action": {
      "description": "__MSG_commandShortenDescription__"
    },
    "_execute_message_display_action": {
      "description": "__MSG_commandOpenReaderDescription__"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "compose_action": {
    "default_title": "kURL",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/kurl-icon-16.png",
      "32": "images/kurl-icon-32.png"
    }
  },
  "message_display_action": {
    "default_title": "kURL",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/kurl-icon-16.png",
      "32": "images/kurl-icon-32.png"
    }
  },
  "permissions": [
    "storage",
    "clipboardWrite",
    "compose",
    "menus",
    "notifications",
    "scripting",
    "messagesRead"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "action": {
    "default_title": "kURL",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/kurl-icon-16.png",
      "32": "images/kurl-icon-32.png"
    }
  }
}
